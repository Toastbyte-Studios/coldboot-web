{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "coldboot-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  // Waitlist storage. The code reads it as `env.DB`. Locally, `wrangler dev`
  // uses a SQLite file under .wrangler/; in production this is the
  // coldboot-waitlist D1 database. Keep a single binding here: if
  // `wrangler d1 create` offers to add another one, decline, and put any new
  // database_id on this entry instead.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coldboot-waitlist",
      "database_id": "d89cad24-5544-44f5-8434-d99437289848",
      "migrations_dir": "migrations",
    },
  ],
}
