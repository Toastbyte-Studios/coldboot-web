---
import Mark from './Mark.astro';
---

<header class="site-header wrap">
  <a class="brand" href="/" aria-label="ColdBoot home">
    <Mark size={40} />
    <span class="wordmark" aria-hidden="true">
      COLDBOOT
    </span>
  </a>
  <a class="pill" href="/#waitlist">
    Join the waitlist
  </a>
</header>

<style>
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 1.75rem;
    position: relative;
    z-index: 2;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    color: var(--cb-text);
    text-decoration: none;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.625rem;
    letter-spacing: 0.04em;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1.375rem;
    border: 1px solid var(--cb-border);
    border-radius: 999px;
    color: var(--cb-text);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .pill:hover {
    border-color: var(--cb-brand);
  }

  /* Narrowest phones: the mark carries the brand on its own so the
     waitlist link keeps to one line. The link's aria-label still names it. */
  @media (max-width: 380px) {
    .wordmark {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .site-header {
      padding-block: 1rem;
    }

    .wordmark {
      font-size: 1.375rem;
    }

    .pill {
      padding: 0 1rem;
      font-size: 0.875rem;
    }
  }
</style>
