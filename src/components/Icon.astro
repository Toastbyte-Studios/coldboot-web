---
/**
 * Outline icons in the style of the app's Ionicons `*-outline` set, drawn
 * locally so the site doesn't pull an icon font. The module icons come first,
 * then the theme toggle's (sunny, moon, contrast) and the feature spotlight's,
 * which follow the app's icons for the same tools and sky events.
 */
import type { IconName as ModuleIconName } from '../data/modules';
import type { SpotlightIcon } from '../data/spotlight';

type IconName =
  | ModuleIconName
  | SpotlightIcon
  | 'sunny'
  | 'moon'
  | 'contrast'
  | 'search'
  | 'bookmark'
  | 'planet'
  | 'snow'
  | 'pause'
  | 'play';

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 24 } = Astro.props;

const PATHS: Record<IconName, string> = {
  pulse: '<polyline points="3 12 7 12 10 5 14 19 17 12 21 12"/>',
  compass:
    '<circle cx="12" cy="12" r="9"/><polygon points="15.5 8.5 13.2 13.2 8.5 15.5 10.8 10.8"/>',
  book: '<path d="M6 3h12v18H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M8 7h6"/><path d="M8 11h6"/>',
  chatbubbles:
    '<path d="M4 5h11a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H9l-4 3v-3H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z"/><path d="M19 9h1a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-1v3l-4-3h-3"/>',
  shield:
    '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><polyline points="9 12 11 14 15 10"/>',
  earth:
    '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.4 2.5 3.6 5.5 3.6 9s-1.2 6.5-3.6 9c-2.4-2.5-3.6-5.5-3.6-9S9.6 5.5 12 3z"/>',
  sunny:
    '<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/>',
  moon: '<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/>',
  contrast:
    '<circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/>',
  flash: '<path d="M13 2.5 5 13.5h6l-1 8 8-11h-6z"/>',
  telescope:
    '<path d="M3.5 13.25 15.25 7l1.75 3.25-11.75 6.25z"/><path d="m15.25 7 3-1.6 1.75 3.25-3 1.6"/><path d="m10 15.25-2.5 6M11.5 14.5l3 6.75"/>',
  cube: '<path d="M12 2.75 20.25 7.5v9L12 21.25 3.75 16.5v-9z"/><path d="M3.75 7.5 12 12.25l8.25-4.75M12 12.25v9"/>',
  search:
    '<circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.25 15.25 5.25 5.25"/>',
  bookmark: '<path d="M6.5 3.5h11v17L12 16.5l-5.5 4z" fill="currentColor"/>',
  planet:
    '<circle cx="12" cy="12" r="5"/><ellipse cx="12" cy="12" rx="10" ry="3.5" transform="rotate(-20 12 12)"/>',
  snow: '<path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9"/><path d="M9.5 4.5 12 6l2.5-1.5M9.5 19.5 12 18l2.5 1.5"/>',
  pause:
    '<rect x="7" y="5.5" width="3" height="13" rx="1" fill="currentColor"/><rect x="14" y="5.5" width="3" height="13" rx="1" fill="currentColor"/>',
  play: '<path d="M8 5.5v13l10.5-6.5z" fill="currentColor"/>',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={PATHS[name]}
/>
