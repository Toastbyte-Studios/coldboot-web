---
/**
 * The ColdBoot home screen in a phone frame, from real captures of the app:
 * the light capture in light mode and the dark one in dark mode.
 *
 * Both images are in the page and `data-theme` on <html> decides which
 * shows, so the screen follows the theme toggle (and System) rather than
 * only the operating system's colour scheme. Without JavaScript the page
 * stays dark, and so does the screen.
 *
 * The phone is in the hero, so both load eagerly: a lazy image in the first
 * viewport would hold back the page's largest paint. The cost is one extra
 * small WebP for the theme that isn't showing.
 */
import { Image } from 'astro:assets';
import homeDark from '../assets/screenshots/home-dark.png';
import homeLight from '../assets/screenshots/home-light.png';

const ALT =
  "The ColdBoot home screen: today's sunset time with pressure, moon phase and GPS status, above the list of six modules.";

// The screen is 320px wide in the 340px frame, and 280px in the 300px frame
// on phones. 2x and 3x cover high-density displays.
const WIDTHS = [280, 320, 560, 640, 960];
const SIZES = '(max-width: 640px) 280px, 320px';

const SHOTS = [
  { theme: 'light', src: homeLight },
  { theme: 'dark', src: homeDark },
] as const;
---

<div class="phone">
  {SHOTS.map(({ theme, src }) => (
    <Image
      src={src}
      alt={ALT}
      widths={WIDTHS}
      sizes={SIZES}
      format="webp"
      quality={80}
      loading="eager"
      decoding="async"
      class:list={['screen', `screen--${theme}`]}
    />
  ))}
</div>

<style>
  .phone {
    width: 340px;
    max-width: 100%;
    border: 10px solid var(--cb-bezel);
    border-radius: 52px;
    overflow: hidden;
    background: var(--cb-bg);
    box-shadow: 0 40px 80px var(--cb-shadow);
  }

  .screen {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Dark is the no-JavaScript default, so it is the one shown unstyled. */
  .screen--light {
    display: none;
  }

  :global([data-theme='light']) .screen--light {
    display: block;
  }

  :global([data-theme='light']) .screen--dark {
    display: none;
  }
</style>
