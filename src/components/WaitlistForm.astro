---
/**
 * Email capture. Posts to /api/subscribe as a plain HTML form so it works
 * without JavaScript. The endpoint arrives in the next PR; until then this
 * form renders but has nothing to submit to.
 */
interface Props {
  /** Unique per page; used to tie the label to its input. */
  id: string;
  centered?: boolean;
  showNote?: boolean;
}

const { id, centered = false, showNote = false } = Astro.props;
const inputId = `${id}-email`;
const noteId = `${id}-note`;
---

<form
  class:list={['waitlist', { centered }]}
  method="post"
  action="/api/subscribe"
>
  <label for={inputId}>Get notified at launch</label>
  <div class="row">
    <input
      id={inputId}
      name="email"
      type="email"
      required
      autocomplete="email"
      inputmode="email"
      placeholder="you@example.com"
      aria-describedby={showNote ? noteId : undefined}
    />
    <button type="submit">Join the waitlist</button>
  </div>
  {showNote && (
    <p class="note" id={noteId}>
      We'll email you when ColdBoot is ready to download. Unsubscribe anytime.
    </p>
  )}
</form>

<style>
  .waitlist {
    display: grid;
    gap: 0.75rem;
    max-width: 34rem;
  }

  .centered {
    margin-inline: auto;
    justify-items: center;
  }

  label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.125em;
    text-transform: uppercase;
    color: var(--cb-muted);
  }

  .row {
    display: flex;
    gap: 0.75rem;
    width: 100%;
  }

  input,
  button {
    height: 3.5rem;
    border-radius: 14px;
    font-family: var(--font-body);
    font-size: 1.0625rem;
  }

  input {
    flex: 1 1 18rem;
    min-width: 0;
    padding: 0 1.125rem;
    background: var(--cb-surface);
    border: 1px solid var(--cb-border);
    color: var(--cb-text);
  }

  input::placeholder {
    color: var(--cb-placeholder);
  }

  input:focus-visible {
    border-color: var(--cb-brand);
  }

  button {
    flex: 0 0 auto;
    padding: 0 1.75rem;
    border: 0;
    background: var(--cb-accent);
    color: var(--cb-bg);
    font-weight: 600;
    cursor: pointer;
  }

  button:hover {
    filter: brightness(1.08);
  }

  .note {
    margin: 0.125rem 0 0;
    font-size: 0.875rem;
    color: var(--cb-muted);
  }

  @media (max-width: 560px) {
    .row {
      flex-direction: column;
    }

    input,
    button {
      width: 100%;
      flex-basis: auto;
    }
  }
</style>
