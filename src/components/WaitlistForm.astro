---
/**
 * Email capture. Posts to /api/subscribe as a plain HTML form so it works
 * without JavaScript; the endpoint redirects to /joined or /join-error.
 */
import { WAITLIST_PROMISE } from '../data/site';
import { HONEYPOT_FIELD } from '../lib/waitlist';
import type { WaitlistSource } from '../lib/waitlist';

interface Props {
  /**
   * Unique per page. Ties the label to its input and is sent as `source` so
   * we can tell which form a signup came from.
   */
  id: WaitlistSource;
  centered?: boolean;
}

const { id, centered = false } = Astro.props;
const inputId = `${id}-email`;
const noteId = `${id}-note`;
const honeypotId = `${id}-${HONEYPOT_FIELD}`;
---

<form
  class:list={['waitlist', { centered }]}
  method="post"
  action="/api/subscribe"
>
  <input type="hidden" name="source" value={id} />
  <!--
    Honeypot: moved off-screen and hidden from assistive tech, so people never
    see it. Bots that fill every field get a success page and are not stored.
  -->
  <div class="hp" aria-hidden="true">
    <label for={honeypotId}>Leave this field empty</label>
    <input
      id={honeypotId}
      name={HONEYPOT_FIELD}
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>
  <label for={inputId}>Get notified at launch</label>
  <div class="row">
    <input
      id={inputId}
      name="email"
      type="email"
      required
      autocomplete="email"
      inputmode="email"
      placeholder="you@example.com"
      aria-describedby={noteId}
    />
    <button type="submit">Join the waitlist</button>
  </div>
  <!--
    Shown on every form, not just the first: this is what people agree to
    when they sign up, so it has to be next to the button they press.
  -->
  <p class="note" id={noteId}>
    {WAITLIST_PROMISE.short} Unsubscribe anytime.{' '}
    <a href="/privacy">Privacy policy</a>
  </p>
</form>

<style>
  .waitlist {
    display: grid;
    gap: 0.75rem;
    max-width: 34rem;
  }

  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .centered {
    margin-inline: auto;
    justify-items: center;
  }

  label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.125em;
    text-transform: uppercase;
    color: var(--cb-muted);
  }

  .row {
    display: flex;
    gap: 0.75rem;
    width: 100%;
  }

  input,
  button {
    height: 3.5rem;
    border-radius: 14px;
    font-family: var(--font-body);
    font-size: 1.0625rem;
  }

  input {
    flex: 1 1 18rem;
    min-width: 0;
    padding: 0 1.125rem;
    background: var(--cb-surface);
    border: 1px solid var(--cb-border);
    color: var(--cb-text);
  }

  input::placeholder {
    color: var(--cb-placeholder);
  }

  input:focus-visible {
    border-color: var(--cb-brand);
  }

  button {
    flex: 0 0 auto;
    padding: 0 1.75rem;
    border: 0;
    background: var(--cb-accent);
    color: var(--cb-bg);
    font-weight: 600;
    cursor: pointer;
  }

  button:hover {
    filter: brightness(1.08);
  }

  .note {
    margin: 0.125rem 0 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--cb-muted);
  }

  @media (max-width: 560px) {
    .row {
      flex-direction: column;
    }

    input,
    button {
      width: 100%;
      flex-basis: auto;
    }
  }
</style>
