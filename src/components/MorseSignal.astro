---
/**
 * A Morse pattern drawn as dots and dashes, e.g. `.-` for A. Decorative:
 * the spoken spell-out ("dot dash") printed beside it is what screen readers
 * and crawlers read, so this is hidden from both.
 *
 * Dashes are three dots long, the same 1:3 ratio as the signal itself.
 */
interface Props {
  morse: string;
  size?: 'md' | 'lg';
}

const { morse, size = 'md' } = Astro.props;
---

<span class:list={['signal', size]} aria-hidden="true">
  {[...morse].map((symbol) =>
    symbol === ' ' ? (
      <span class="gap" />
    ) : (
      <span class={symbol === '-' ? 'dash' : 'dot'} />
    ),
  )}
</span>

<style>
  .signal {
    --u: 0.4375rem;
    display: inline-flex;
    align-items: center;
    gap: var(--u);
    min-height: calc(var(--u) * 2);
  }

  /*
   * Scales with the viewport so the widest large pattern (SOS, 27 units)
   * still fits a card on a 320px screen: 2.6vw is about 8px there, and the
   * full 12px from roughly 460px up.
   */
  .lg {
    --u: clamp(0.4375rem, 2.6vw, 0.75rem);
  }

  .dot,
  .dash {
    height: var(--u);
    border-radius: 999px;
    background: currentColor;
  }

  .dot {
    width: var(--u);
  }

  .dash {
    width: calc(var(--u) * 3);
  }

  /* A letter gap is three units; the flex gap already supplies two. */
  .gap {
    width: var(--u);
  }

  @media print {
    /*
     * 4px units, so the longest code (0, five dashes: 76px) fits a card in
     * the six-column print chart on Letter or A4 with normal margins.
     */
    .signal,
    .lg {
      --u: 0.25rem;
    }

    .dot,
    .dash {
      /* Backgrounds are often dropped when printing; borders aren't. */
      background: none;
      border: calc(var(--u) / 2) solid currentColor;
    }
  }
</style>
