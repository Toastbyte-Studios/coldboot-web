---
import { SAMPLE_MORSE } from '../../data/spotlight';
import SpotlightCard from './SpotlightCard.astro';
---

<SpotlightCard
  title="Alpha to Morse"
  meta="Transmitting"
  label={`Alpha to Morse sending “${SAMPLE_MORSE.message}” with the phone's light, with the tone on.`}
>
  <div class="field">
    <span class="field-label">Message</span>
    <span class="field-value">{SAMPLE_MORSE.message}</span>
  </div>
  <p class="code">{SAMPLE_MORSE.code}</p>
  <div class="signal">
    <span class="light"></span>
    <span class="signal-text">
      <strong>Torch</strong>
      <span>Flashing the message</span>
    </span>
    <span class="tone">Tone on</span>
  </div>
</SpotlightCard>

<style>
  .field {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.875rem 1rem;
    border: 1px solid var(--cb-border);
    border-radius: 14px;
    background: var(--cb-bg);
  }

  .field-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cb-muted);
  }

  .field-value {
    font-weight: 600;
    font-size: 1.125rem;
    letter-spacing: 0.2em;
  }

  .code {
    margin: 1.75rem 0;
    font-family: var(--font-mono);
    font-size: clamp(2rem, 4vw, 2.75rem);
    letter-spacing: 0.12em;
    text-align: center;
    white-space: nowrap;
  }

  .signal {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--cb-separator);
  }

  /* The lamp blinks S-O-S at 250 ms a unit (dot 1, dash 3, gaps 1, 3 and
     7), so at most two flashes a second: well under WCAG's three-flash
     limit. */
  .light {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border: 2px solid var(--cb-border);
    border-radius: 50%;
  }

  :global([data-spotlight][data-state='running'] [data-active]) .light {
    animation: spotlight-sos 8.5s steps(1, end) infinite;
  }

  @keyframes spotlight-sos {
    0%,
    5.88%,
    11.76%,
    23.53%,
    35.29%,
    47.06%,
    64.71%,
    70.59%,
    76.47% {
      border-color: var(--cb-lamp);
      background: var(--cb-lamp);
      box-shadow: 0 0 18px color-mix(in srgb, var(--cb-lamp) 60%, transparent);
    }

    2.94%,
    8.82%,
    14.71%,
    32.35%,
    44.12%,
    55.88%,
    67.65%,
    73.53%,
    79.41%,
    100% {
      border-color: var(--cb-border);
      background: transparent;
      box-shadow: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .light {
      animation: none;
      border-color: var(--cb-lamp);
      background: var(--cb-lamp);
    }
  }

  .signal-text {
    display: grid;
    font-size: 0.875rem;
    color: var(--cb-muted);
  }

  .signal-text strong {
    font-size: 1rem;
    color: var(--cb-text);
  }

  .tone {
    margin-left: auto;
    padding: 0.375rem 0.75rem;
    border-radius: 999px;
    background: var(--cb-secondary-container);
    color: var(--cb-on-secondary-container);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }
</style>
