---
import { version } from '../../package.json';
import { SITE } from '../data/site';

// Read at build time, like alley-admin's footer. Every PR bumps the version
// and every merge to main ships it, so this is the version that's live.
const releaseUrl = `${SITE.repoUrl}/releases/tag/v${version}`;
---

<footer class="site-footer wrap">
  <p>
    ColdBoot is made by{' '}
    <a href={SITE.studio.url} data-outbound="toastbyte-studio">
      {SITE.studio.name}
    </a>
  </p>
  <nav aria-label="Footer">
    <a href="/privacy">Privacy</a>
    <!--
      Hidden until the script below confirms consent is being asked for.
      With PUBLIC_ANALYTICS_REQUIRE_CONSENT=0 there is no choice to revisit,
      and a button that reopened an empty decision would just be confusing.
    -->
    <button type="button" class="linkish" data-consent-reopen hidden>
      Cookie settings
    </button>
    <a href={`mailto:${SITE.contactEmail}`}>Contact</a>
    <span>
      © {new Date().getFullYear()} {SITE.studio.legalName}
    </span>
    <a
      class="build"
      href={releaseUrl}
      data-outbound="github-release"
      aria-label={`Version ${version} release notes`}
    >
      <span class="build-dot" aria-hidden="true"></span>v{version}
    </a>
  </nav>
</footer>

<script>
  import {
    ANALYTICS_EVENTS,
    getAnalyticsConsentRequirement,
    trackClientEvent,
  } from '../lib/analytics-client';

  // Keyed off the attribute rather than an id, so tracking another outbound
  // link is a markup change, not a script change.
  for (const link of document.querySelectorAll('a[data-outbound]')) {
    if (!(link instanceof HTMLAnchorElement)) continue;

    link.addEventListener('click', () => {
      trackClientEvent(ANALYTICS_EVENTS.outboundLinkClicked, {
        destination: link.dataset.outbound ?? 'unknown',
      });
    });
  }

  // Withdrawing consent has to be as easy as giving it, so the banner needs a
  // way back once it has been answered. ConsentBanner.astro listens for
  // `consent:reopen`.
  if (getAnalyticsConsentRequirement()) {
    for (const button of document.querySelectorAll<HTMLButtonElement>(
      '[data-consent-reopen]',
    )) {
      button.hidden = false;
      button.addEventListener('click', () => {
        document.dispatchEvent(
          new CustomEvent('consent:reopen', { detail: { opener: button } }),
        );
      });
    }
  }
</script>

<style>
  .site-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.75rem;
    padding-block: 2rem 2.5rem;
    border-top: 1px solid var(--cb-separator);
    font-size: 0.9375rem;
    color: var(--cb-muted-ground);
  }

  p {
    margin: 0;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
  }

  /*
   * The version as a quiet status readout, in the same mono label voice as
   * the hero readouts and spotlight cards. The dot is brand blue, not amber:
   * amber is reserved for the primary action.
   */
  .build {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--cb-separator);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    line-height: 1.4;
    color: var(--cb-muted-ground);
    text-decoration: none;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .build:hover {
    color: var(--cb-brand);
    border-color: var(--cb-brand);
  }

  .build-dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--cb-brand);
  }

  @media (prefers-reduced-motion: reduce) {
    .build {
      transition: none;
    }
  }

  /*
   * A button, because it opens something rather than navigating. Styled like
   * the links beside it so the row still reads as one set.
   */
  .linkish {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--cb-brand);
    text-decoration: underline;
    cursor: pointer;
  }

  .linkish:hover {
    color: var(--cb-text);
  }

  .linkish[hidden] {
    display: none;
  }

  @media (max-width: 640px) {
    .site-footer {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
