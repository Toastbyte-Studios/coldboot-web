---
/**
 * The ColdBoot bootprint on its dark tile.
 *
 * Path data is the mark from ColdBoot's `assets/coldboot-assets/svg`. The tile
 * gradient comes from `--cb-tile-dark` rather than an SVG <linearGradient>, so
 * several marks on one page never collide on a gradient id.
 */
interface Props {
  size: number;
  class?: string;
}

const { size, class: className } = Astro.props;
---

<span
  class:list={['mark', className]}
  style={`--mark-size: ${size}px`}
  aria-hidden="true"
>
  <svg viewBox="0 0 120 120" focusable="false">
    <path
      fill-rule="evenodd"
      transform="rotate(-7 60 60) scale(0.84) translate(11 11)"
      d="M60 8 C47 8 39 15 36 26 C33 37 36 47 39 54 C42 61 47 64 47 70 C47 76 44 79 44 85 C44 97 48 112 60 112 C72 112 77 97 77 85 C77 79 74 76 74 70 C74 64 79 61 82 54 C85 47 88 37 85 26 C82 15 73 8 60 8 Z M45 22 L60 17 L75 22 L75 25.5 L60 20.5 L45 25.5 Z M39 30 L60 24 L81 30 L81 34 L60 28 L39 34 Z M38 40 L60 34 L82 40 L82 44 L60 38 L38 44 Z M39.5 50 L60 44 L80.5 50 L80.5 54 L60 48 L39.5 54 Z M43 56 L60 52 L77 56 L77 59 L60 55 L43 59 Z M60 68 a7 7 0 1 0 0 14 a7 7 0 1 0 0 -14 Z M60 71.5 a3.5 3.5 0 1 0 0 7 a3.5 3.5 0 1 0 0 -7 Z M58 65 h4 v10 h-4 Z M47 93 L60 88 L73 93 L73 96.5 L60 91.5 L47 96.5 Z M48 100.5 L60 96 L72 100.5 L72 103.7 L60 99.2 L48 103.7 Z M53 104.9 L60 101.4 L67 104.9 L67 107.7 L60 104.2 L53 107.7 Z"
    ></path>
  </svg>
</span>

<style>
  .mark {
    display: inline-block;
    flex-shrink: 0;
    width: var(--mark-size);
    height: var(--mark-size);
    border-radius: 22%;
    background: var(--cb-tile-dark);
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: var(--cb-ice);
  }
</style>
