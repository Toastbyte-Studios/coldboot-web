---
/**
 * A small centered page for form results (/joined, /join-error): the mark,
 * a heading, a message and whatever the page adds in its slot.
 */
import Mark from '../components/Mark.astro';
import Base from './Base.astro';

interface Props {
  title: string;
  heading: string;
}

const { title, heading } = Astro.props;
---

<Base title={`${title} — ColdBoot`} description="ColdBoot waitlist." noindex>
  <main class="notice wrap">
    <a href="/" aria-label="ColdBoot home">
      <Mark size={72} />
    </a>
    <h1>{heading}</h1>
    <slot />
    <button type="button" class="cookie-settings" data-consent-reopen hidden>
      Cookie settings
    </button>
  </main>
</Base>

<script>
  import { getAnalyticsConsentRequirement } from '../lib/analytics-client';

  const button = document.querySelector<HTMLButtonElement>(
    '[data-consent-reopen]',
  );
  if (button && getAnalyticsConsentRequirement()) {
    button.hidden = false;
    button.addEventListener('click', () => {
      document.dispatchEvent(
        new CustomEvent('consent:reopen', { detail: { opener: button } }),
      );
    });
  }
</script>

<style>
  .notice {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding-block: 4rem;
    text-align: center;
  }

  h1 {
    margin: 0.5rem 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.75rem, 7vw, 4.5rem);
    line-height: 0.95;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .notice :global(p) {
    margin: 0;
    max-width: 32rem;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--cb-muted-ground);
  }

  .notice :global(.waitlist) {
    width: 100%;
    margin-top: 1rem;
  }

  .cookie-settings {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--cb-brand);
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  .cookie-settings:focus-visible {
    outline: 2px solid var(--cb-brand);
    outline-offset: 3px;
  }
</style>
