---
import { Font } from 'astro:assets';
import { SITE } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Keep utility pages (form results) out of search results. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
// With build.format 'file', pages build as privacy.html and index.html, and
// Astro.url reflects that. The public URLs are /privacy and /, so strip the
// suffix to keep canonical and og:url pointing at the addresses people use.
const publicPath = Astro.url.pathname.replace(/(index)?\.html$/, '');
const canonical = new URL(publicPath, Astro.site);
// Link previews need an absolute image URL.
const shareImage = new URL(SITE.shareImage.path, Astro.site);
---

<!doctype html>
<!--
  data-theme="dark" is the no-JavaScript default. With JavaScript, the inline
  script below replaces it with the visitor's choice before first paint.
-->
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-display" preload={[{ weight: '700' }]} />
    <Font cssVariable="--font-body" preload={[{ weight: '400' }]} />
    <Font cssVariable="--font-mono" />
    <!-- BACKGROUND in each scheme. The script turns on the one in use. -->
    <meta name="theme-color" content="#101b24" data-scheme="dark" />
    <meta
      name="theme-color"
      content="#dcecf7"
      data-scheme="light"
      media="not all"
    />
    <script is:inline>
      // Theme: 'light', 'dark' or 'system' (the default), like the app's
      // Settings → Appearance → Theme. Runs before first paint so the page
      // never flashes the wrong scheme. Only an explicit Light or Dark choice
      // is stored; choosing System clears it. See ThemeToggle.astro.
      (() => {
        const KEY = 'coldboot-theme';
        const root = document.documentElement;
        // Lets CSS lay out scripted components (the feature spotlight) in
        // their JavaScript state from first paint, so nothing shifts.
        root.classList.add('js');
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        let choice = 'system';

        const load = () => {
          let saved = null;
          try {
            saved = localStorage.getItem(KEY);
          } catch {
            // Storage blocked: fall back to following the system.
          }
          choice = saved === 'light' || saved === 'dark' ? saved : 'system';
        };

        const apply = () => {
          const system = media.matches ? 'dark' : 'light';
          const scheme = choice === 'system' ? system : choice;
          root.dataset.theme = scheme;
          document.querySelectorAll('meta[name="theme-color"]').forEach((m) => {
            m.setAttribute(
              'media',
              m.dataset.scheme === scheme ? 'all' : 'not all',
            );
          });
        };

        const syncToggles = () => {
          document.querySelectorAll('[data-theme-toggle]').forEach((toggle) => {
            const input = toggle.querySelector(`input[value="${choice}"]`);
            if (input) input.checked = true;
            toggle.hidden = false;
          });
        };

        const refresh = () => {
          load();
          apply();
          syncToggles();
        };

        load();
        apply();
        media.addEventListener('change', apply);
        document.addEventListener('DOMContentLoaded', syncToggles);
        // Another tab changed it, or this page came back from the back/forward
        // cache after the choice changed elsewhere.
        window.addEventListener('storage', (e) => {
          if (e.key === KEY || e.key === null) refresh();
        });
        window.addEventListener('pageshow', (e) => {
          if (e.persisted) refresh();
        });
        document.addEventListener('change', (e) => {
          const input = e.target;
          if (!input.closest || !input.closest('[data-theme-toggle]')) return;
          choice = input.value;
          try {
            if (choice === 'system') localStorage.removeItem(KEY);
            else localStorage.setItem(KEY, choice);
          } catch {
            // Storage blocked: the choice still applies to this page.
          }
          apply();
        });
      })();
    </script>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ColdBoot" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(SITE.shareImage.width)} />
    <meta property="og:image:height" content={String(SITE.shareImage.height)} />
    <meta property="og:image:alt" content={SITE.shareImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={SITE.shareImage.alt} />
  </head>
  <body>
    <slot />
  </body>
</html>
