---
import WaitlistForm from '../components/WaitlistForm.astro';
import Notice from '../layouts/Notice.astro';
---

<Notice title="That didn't go through" heading="That didn't go through.">
  <p>
    Check the email address and try again. If it keeps happening, it's on our
    end, and trying again a little later should work.
  </p>
  <WaitlistForm id="retry" centered />
</Notice>

<script>
  import {
    ANALYTICS_EVENTS,
    takeWaitlistSubmission,
    trackClientEvent,
  } from '../lib/analytics-client';

  // Only when this tab just submitted, so a reload or a direct visit isn't
  // counted. The reason comes from the endpoint's redirect.
  const form = takeWaitlistSubmission();
  if (form) {
    const reason = new URLSearchParams(window.location.search).get('reason');
    trackClientEvent(ANALYTICS_EVENTS.waitlistSignupFailed, {
      form,
      reason: reason === 'invalid_email' ? reason : 'server_error',
    });
  }
</script>
