---
/**
 * Privacy policy for coldboot.app.
 *
 * Every statement here has to stay true of the code. If you change what the
 * waitlist stores (migrations/), add cookies, analytics, a third-party script
 * or anything else stored in the browser, or pick an email provider, update
 * this page and PRIVACY.lastUpdated in src/data/site.ts in the same PR.
 *
 * The analytics sections were written against:
 *
 *   src/lib/analytics-events.ts       which events are sent, with which params
 *   src/lib/analytics-consent.ts      the consent cookie and its lifetime
 *   src/lib/analytics-client.ts       the consent gate, session-storage key
 *   src/lib/analytics-relay.ts        the fallback and its derived identifier
 *   src/components/ConsentBanner.astro
 *
 * The Zaraz cookie names and lifetimes come from the Cloudflare dashboard
 * (Zaraz > Google Analytics 4 > Cookies, and Zaraz > Consent), not from this
 * repository. Re-check them there if the Zaraz configuration changes.
 *
 * Cloudflare Web Analytics (the /cdn-cgi/rum beacon) is also switched on in
 * the dashboard, not in code, and runs regardless of consent. If it's turned
 * off for the zone, remove it from "Visiting the site" and the summary.
 */
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { PRIVACY, SITE, WAITLIST_PROMISE } from '../data/site';
import Base from '../layouts/Base.astro';

const updated = new Date(`${PRIVACY.lastUpdated}T00:00:00Z`);
const updatedLabel = updated.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const mailto = `mailto:${SITE.contactEmail}`;
---

<Base
  title="Privacy policy — ColdBoot"
  description="What coldboot.app collects, why, and how to have it deleted."
>
  <SiteHeader />

  <main class="policy wrap">
    <article>
      <header>
        <p class="eyebrow">coldboot.app</p>
        <h1>Privacy policy</h1>
        <p class="updated">
          Last updated{' '}
          <time datetime={PRIVACY.lastUpdated}>{updatedLabel}</time>
        </p>
      </header>

      <p>
        This policy covers <strong>coldboot.app</strong>, the website for
        ColdBoot, run by {SITE.studio.legalName} ("we", "us"). It explains what
        we collect when you visit the site or join the waitlist, and what we do
        with it. It covers this website only, not the ColdBoot app.
      </p>

      <section class="summary" aria-labelledby="short-version">
        <h2 id="short-version">The short version</h2>
        <ul>
          <li>
            The only personal information we ask you for is the email address
            you give us to join the waitlist.
          </li>
          <li>{WAITLIST_PROMISE.full}</li>
          <li>
            We don't sell it, rent it, or share it for anyone else's marketing.
          </li>
          <li>
            If you say yes, we use Google Analytics to count visits and see how
            the site is used. It stays off until you do, and saying no changes
            nothing else about the site. There are no ad trackers.
          </li>
          <li>
            For every visitor, our host also counts page loads and measures how
            fast pages load. That uses no cookies and doesn't identify you.
          </li>
          <li>
            You can unsubscribe or ask us to delete your address at any time.
          </li>
        </ul>
      </section>

      <section aria-labelledby="collect">
        <h2 id="collect">What we collect</h2>
        <p>When you join the waitlist, we store:</p>
        <ul>
          <li>your email address,</li>
          <li>the date and time you signed up, and</li>
          <li>which signup form on the site you used.</li>
        </ul>
        <p>
          That's all. We don't ask for your name, and we don't store your IP
          address, device or browser details with your signup.
        </p>
      </section>

      <section aria-labelledby="visiting">
        <h2 id="visiting">Visiting the site</h2>
        <p>
          Like any website, coldboot.app receives some technical information in
          order to work, such as your IP address and browser type. Our hosting
          provider, Cloudflare, processes it to deliver pages and protect the
          site from abuse. Some of it may appear in operational logs, which we
          use only to keep the site working and secure, not to identify you.
          This happens for every visitor and is separate from the analytics
          below.
        </p>
        <p>
          We also use Cloudflare Web Analytics, which runs for every visitor
          whatever you answer about Google Analytics. A small script reports
          which page you opened, the site that sent you here, and how quickly
          the page loaded, so we can count visits and keep the site fast. It
          doesn't set cookies or store anything in your browser, doesn't
          fingerprint you, and Cloudflare discards your IP address rather than
          storing it with this data. It isn't linked to Google Analytics or to
          your email address.
        </p>
        <p>
          Fonts are served from coldboot.app itself, so your browser doesn't
          contact a font service. There are no advertising scripts.
        </p>
      </section>

      <section aria-labelledby="analytics">
        <h2 id="analytics">Analytics</h2>
        <p>
          The first time you visit, we ask whether we may use analytics. Until
          you answer, and if you say no, none of what this section describes
          happens.
        </p>
        <p>
          If you say yes, we use Google Analytics 4 to understand how the site
          is used. It runs through Cloudflare Zaraz, which serves the analytics
          script from coldboot.app rather than from a Google domain and passes
          the data on to Google from Cloudflare's network. Google Analytics
          records page views, along with the general information it collects
          about any visit, such as your approximate location, device type and
          the site that sent you here. We also send these events, and no others:
        </p>
        <ul>
          <li>
            <strong>waitlist_signup_started</strong>: you submitted a waitlist
            form, and which one.
          </li>
          <li>
            <strong>waitlist_signup_succeeded</strong>: the signup went through.
            The <code>form</code> parameter identifies which form you used.
          </li>
          <li>
            <strong>waitlist_signup_failed</strong>: it didn't, and whether the
            address was rejected or something failed on our end, and which form
            you used in the <code>form</code> parameter.
          </li>
          <li>
            <strong>outbound_link_clicked</strong>: you followed a link to
            another site, and where it pointed.
          </li>
          <li>
            <strong>theme_toggled</strong>: you picked Light, Dark or System.
          </li>
        </ul>
        <p>
          <strong>Your email address is never sent to Google Analytics</strong>,
          in any form. The signup events record that a signup happened and
          whether it worked, never who it was for. Ad personalization is turned
          off for the data we send.
        </p>
        <p>
          If the analytics script doesn't load in your browser, for example
          because it was blocked or was slow, the site sends the same events
          through our own server instead, and only if you said yes. With no
          analytics cookie to go on, our server makes a temporary identifier by
          scrambling your IP address, browser type and language setting
          together. We don't store that identifier separately, but Google
          receives and retains it with the analytics data. It isn't linked to
          your email address or an account. This should be rare, and we'd rather
          tell you it exists than leave it out.
        </p>
      </section>

      <section aria-labelledby="cookies">
        <h2 id="cookies">Cookies and browser storage</h2>
        <p>Everything below is set for coldboot.app alone.</p>
        <ul>
          <li>
            <strong>analytics-consent</strong> (cookie, one year) remembers
            whether you said yes or no to analytics, so we don't ask on every
            page. It holds that answer and nothing else.
          </li>
          <li>
            <strong>zaraz-consent</strong> (cookie) is Cloudflare Zaraz's own
            record of the same answer, which it checks before loading analytics.
          </li>
          <li>
            <strong>_zaraz_consent</strong> (local storage) is another copy
            Zaraz keeps of that answer, as yes or no for analytics and for ads.
            We don't run ads, so the ads value is always no.
          </li>
          <li>
            <strong>cfz_google-analytics_v4</strong> (cookie, up to one year)
            holds the identifier Google Analytics uses to recognise a returning
            browser. Only set if you said yes.
          </li>
          <li>
            <strong>cfzs_google-analytics_v4</strong> (cookie, deleted when you
            close your browser) keeps track of your current visit. Only set if
            you said yes.
          </li>
          <li>
            <strong>coldboot-theme</strong> (local storage) remembers Light or
            Dark if you pick one with the theme switch. It's never sent to us,
            and picking System clears it.
          </li>
          <li>
            <strong>coldboot-waitlist-pending</strong> (session storage) is set
            only if you said yes to analytics and then submit the waitlist form.
            It holds which form you used, so the next page can record whether
            the signup worked, and that page deletes it straight away.
          </li>
        </ul>
        <p>
          You can change your answer at any time with{' '}
          <strong>Cookie settings</strong> at the bottom of every page. Clearing
          this site's cookies also resets the identifier Google Analytics uses
          for you.
        </p>
      </section>

      <section aria-labelledby="use">
        <h2 id="use">How we use your email address</h2>
        <p>
          {WAITLIST_PROMISE.full} We won't use it for anything else, and every
          email we send includes a link to unsubscribe.
        </p>
        <p>
          If you're in the European Union or the United Kingdom, we rely on your
          consent, which you give by joining the waitlist. You can withdraw it
          at any time by unsubscribing or emailing us.
        </p>
      </section>

      <section aria-labelledby="sharing">
        <h2 id="sharing">Who we share it with</h2>
        <p>
          We don't sell, rent or trade your email address, and we don't share it
          with anyone for their own marketing. We use service providers that
          handle it on our behalf, only to provide their service to us:
        </p>
        <ul>
          <li>
            <strong>Cloudflare</strong> hosts this site and the database the
            waitlist is stored in, runs Zaraz, which loads our analytics, and
            provides Web Analytics.
          </li>
          <li>
            <strong>Google</strong> receives the analytics described above, if
            you said yes. It never receives your email address. How Google uses
            data from sites like ours is explained at{' '}
            <a
              href="https://policies.google.com/technologies/partner-sites"
              data-outbound="google-policy"
            >
              policies.google.com/technologies/partner-sites
            </a>
            .
          </li>
          <li>
            <strong>An email delivery service</strong> will send our emails. We
            haven't chosen one yet, and we'll name it on this page before we
            send the first email.
          </li>
        </ul>
        <p>
          We may also disclose information if the law requires it, or to protect
          the rights and safety of our users or ourselves.
        </p>
      </section>

      <section aria-labelledby="storage">
        <h2 id="storage">Where it's stored</h2>
        <p>
          The waitlist is stored with Cloudflare. Cloudflare runs a global
          network, so your information may be processed outside the country you
          live in, including in the United States.
        </p>
      </section>

      <section aria-labelledby="retention">
        <h2 id="retention">How long we keep it</h2>
        <p>
          We keep your email address until you unsubscribe or ask us to delete
          it. When you do, we remove it from our list.
        </p>
        <p>
          Google keeps analytics data according to the retention setting on our
          Google Analytics property. It isn't linked to your email address.
        </p>
      </section>

      <section aria-labelledby="rights">
        <h2 id="rights">Your choices and rights</h2>
        <ul>
          <li>Unsubscribe with the link at the bottom of any email we send.</li>
          <li>
            Email <a href={mailto}>{SITE.contactEmail}</a> to find out what we
            hold about you, correct it, or have it deleted.
          </li>
        </ul>
        <p>
          Depending on where you live, for example in the EU, the UK or
          California, the law may give you further rights over your personal
          information. Email us to use any of them and we'll respond within the
          time the law requires.
        </p>
        <p>
          One limitation: analytics data isn't linked to your email address or
          to an account, so we can't look up which analytics events were yours
          in order to delete them. Saying no, or clearing this site's cookies,
          stops any more being collected.
        </p>
      </section>

      <section aria-labelledby="children">
        <h2 id="children">Children</h2>
        <p>
          This site isn't directed at children under 13, and we don't knowingly
          collect their information. If you think a child has joined the
          waitlist, email us and we'll delete their address.
        </p>
      </section>

      <section aria-labelledby="changes">
        <h2 id="changes">Changes to this policy</h2>
        <p>
          When we change this policy, we'll update the date at the top. If we
          make a significant change to how we use your email address, we'll tell
          you by email before it takes effect.
        </p>
      </section>

      <section aria-labelledby="contact">
        <h2 id="contact">Contact</h2>
        <p>
          {SITE.studio.legalName}
          <br />
          <a href={mailto}>{SITE.contactEmail}</a>
        </p>
      </section>
    </article>
  </main>

  <SiteFooter />
</Base>

<style>
  .policy {
    padding-block: 3rem 6rem;
  }

  article {
    max-width: 42rem;
  }

  .eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--cb-brand);
  }

  h1 {
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3rem, 7vw, 4.5rem);
    line-height: 0.92;
    text-transform: uppercase;
  }

  .updated {
    margin: 1rem 0 2.5rem;
    font-size: 0.9375rem;
    color: var(--cb-muted-ground);
  }

  h2 {
    margin: 3rem 0 0.75rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.875rem;
    line-height: 1.05;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  p,
  li {
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  p {
    margin: 0 0 1rem;
  }

  ul {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
  }

  li + li {
    margin-top: 0.5rem;
  }

  li::marker {
    color: var(--cb-brand);
  }

  .summary {
    margin-top: 2rem;
    padding: 1.5rem 1.75rem 0.5rem;
    border: 1px solid var(--cb-border);
    border-radius: 20px;
    background: var(--cb-surface);
  }

  .summary h2 {
    margin-top: 0;
    font-size: 1.5rem;
  }

  @media (max-width: 640px) {
    .policy {
      padding-block: 1.5rem 4rem;
    }

    .summary {
      padding: 1.25rem 1.25rem 0.25rem;
    }
  }
</style>
